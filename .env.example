# ============================================================
# Sao chep file nay thanh .env.local roi dien gia tri. KHONG commit .env.local.
# ============================================================

# ---- Supabase (bat buoc de dung trang Admin that) ----
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: BI MAT, chi dung o server. Khong bao gio dat ten NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Xem thu Admin khi CHUA co Supabase (chi chay voi `npm run dev`) ----
# Mat khau toi thieu 12 ky tu. Ban build production (npm run build/start) khong bao gio bat che do nay.
ADMIN_DEMO_PASSWORD=

# ---- Gia tri ban dau cho dia chi / ban do (tuy chon) ----
# Tu Patch 11, chu tiem sua trong Admin > Cai dat; cac bien nay chi la gia tri mac dinh.
NEXT_PUBLIC_STORE_ADDRESS=
NEXT_PUBLIC_STORE_MAP_URL=
NEXT_PUBLIC_STORE_MAP_EMBED_URL=

# Dia chi web chinh thuc (khong co dau / cuoi), vd https://theyub.vn
# Dung lam dia chi quay lai sau khi khach dang nhap Google. Bo trong khi chay thu tren may.
NEXT_PUBLIC_SITE_URL=
